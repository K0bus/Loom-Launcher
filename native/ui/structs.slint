export struct GameData {
    id: string,
    title: string,
    subtitle: string,
    platform: string,       // steam | epic | gog | minecraft | battlenet | manual
    platform-variant: int,  // variante UiBadge
    genre: string,
    playtime: string,       // "12.5 h" ou "Non joué"
    size-label: string,     // "54 Go" | "À télécharger" | runner
    installed: bool,
    favorite: bool,
    running: bool,
    starting: bool,
    cover: image,
    has-cover: bool,
    hue: color,             // couleur de fond de repli quand pas de jaquette
}

export struct ListRow {
    name: string,
    detail: string,
    badge: string,
    badge-variant: int,
}
