// Équivalent de src/views/GameDetailView.vue
import { ScrollView } from "std-widgets.slint";
import { Theme, Icons } from "../theme.slint";
import { Ph } from "../components/ph.slint";
import { UiBadge, UiButton, UiModal, UiSwitch } from "../components/ui.slint";
import { BackLink, Panel, Chip } from "../components/studio.slint";
import { UiSelect, FieldLabel, SecretInput } from "../components/form.slint";
import { GameData } from "../structs.slint";

export struct AchRow { name: string, desc: string, rarity: string, unlocked: bool, icon: image, has-icon: bool }
export struct ShotRow { img: image, has: bool }
export struct NewsRow { tag: string, patch: bool, author: string, date: string, title: string, summary: string }

export global Detail {
    in property <bool> loading;
    in property <GameData> game;
    in property <image> banner;
    in property <bool> has-banner;
    in property <string> developer;
    in property <string> runner;
    in property <string> genres;
    in property <string> description;
    in property <string> last-played;
    in property <string> rating;
    in property <string> release;
    in property <string> size;
    in property <int> ach-total;
    in property <int> ach-unlocked;
    in property <float> ach-pct;
    in property <[AchRow]> ach-preview;
    in property <[AchRow]> ach-all;
    in-out property <bool> ach-open;
    in property <[ShotRow]> shots;
    in-out property <bool> shot-open;
    in property <image> shot-big;
    in property <bool> shot-ready;
    in-out property <int> news-filter: 0;
    in property <[NewsRow]> news;
    in property <[[string]]> cfg-rows;
    in property <[[string]]> links;        // [libellé, url]
    in property <[[string]]> stores;
    in-out property <bool> uninstall-open;
    in-out property <bool> cfg-open;
    in-out property <int> cfg-runner: 0;
    in-out property <bool> cfg-gamemode;
    in-out property <bool> cfg-mangohud;
    in-out property <string> cfg-env;
    in property <string> launch-opts;

    callback back();
    callback cfg-save();
    callback cfg-copy();
    callback cfg-refresh();
    callback play();
    callback stop();
    callback install();
    callback uninstall-confirm();
    callback open-url(string);
    callback open-shot(int);
    callback toggle-favorite();
    callback open-folder();
    callback news-click(int);
}

component Metric inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <color> tint: Theme.zinc-100;
    spacing: 0px;
    VerticalLayout {
        alignment: center; spacing: 2px;
        Text { text: root.label; font-family: Theme.font-mono; font-size: 10px; font-weight: 600; color: Theme.zinc-500; }
        Text { text: root.value; font-family: Theme.font-mono; font-size: 14px; font-weight: 700; color: root.tint; }
    }
}

component LinkItem inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-width: l.min-width; preferred-width: l.preferred-width; height: 36px;
    l := HorizontalLayout {
        spacing: 6px; padding-left: 4px; padding-right: 4px;
        Text { text: root.text; font-size: 12px; font-weight: 500; vertical-alignment: center; color: ta.has-hover ? Theme.amber-400 : Theme.zinc-400; }
        Ph { text: Icons.external; font-size: 11px; color: ta.has-hover ? Theme.amber-400 : Theme.zinc-600; width: 14px; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component SectionHeading inherits HorizontalLayout {
    in property <string> glyph;
    in property <string> text;
    in property <string> right;
    spacing: 10px;
    Ph { weight: 1; text: root.glyph; font-size: 18px; color: Theme.amber-400; width: 22px; }
    Text { horizontal-stretch: 1; text: root.text; font-size: 17px; font-weight: 800; color: Theme.zinc-100; vertical-alignment: center; }
    if root.right != "": Text { text: root.right; font-family: Theme.font-mono; font-size: 11px; color: Theme.zinc-500; vertical-alignment: center; }
}

component AchItem inherits Rectangle {
    in property <AchRow> a;
    height: 58px;
    HorizontalLayout {
        spacing: 12px;
        Rectangle {
            width: 40px; border-radius: 10px; clip: true; background: Theme.zinc-950; border-width: 1px; border-color: root.a.unlocked ? Theme.amber-border-soft : Theme.zinc-800;
            if root.a.has-icon: Image { source: root.a.icon; width: parent.width; height: parent.height; image-fit: cover; opacity: root.a.unlocked ? 1.0 : 0.4; }
            if !root.a.has-icon: Ph { weight: 1; text: Icons.trophy; font-size: 18px; color: root.a.unlocked ? Theme.amber-400 : Theme.zinc-600; }
        }
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 2px;
            HorizontalLayout { spacing: 8px; Text { horizontal-stretch: 1; text: root.a.name; font-size: 12px; font-weight: 700; color: root.a.unlocked ? Theme.zinc-100 : Theme.zinc-400; overflow: elide; } Text { text: root.a.rarity; font-family: Theme.font-mono; font-size: 10px; color: Theme.amber-400; } }
            Text { text: root.a.desc; font-size: 11px; color: Theme.zinc-500; overflow: elide; }
        }
    }
}

export component GameDetail inherits Rectangle {
    background: Theme.zinc-950;
    private property <length> pad: max(56px, (root.width - 1280px) / 2 + 56px);

    ScrollView {
        VerticalLayout {
            // ============ HERO ============
            Rectangle {
                height: 380px; clip: true; background: Theme.zinc-950;
                if Detail.has-banner: Image { source: Detail.banner; width: parent.width; height: parent.height; image-fit: cover; }
                if !Detail.has-banner: Rectangle { background: @linear-gradient(135deg, Theme.zinc-800, Theme.zinc-950); }
                Rectangle { background: @radial-gradient(circle, Theme.amber-500.with-alpha(0.18) 0%, #dc262620 40%, transparent 70%); }
                Rectangle { background: @linear-gradient(90deg, #09090bd9 0%, #09090b4d 50%, #09090bb3 100%); }
                Rectangle { background: @linear-gradient(0deg, #09090b 0%, #09090b66 45%, transparent 100%); }

                BackLink { x: root.pad; y: 24px; width: 190px; text: "Retour à la bibliothèque"; clicked => { Detail.back(); } }

                HorizontalLayout {
                    x: root.pad; y: parent.height - 190px; width: parent.width - root.pad * 2; height: 160px; spacing: 24px;
                    Rectangle {
                        width: 120px; height: 160px; border-radius: 16px; clip: true; background: Theme.zinc-900; border-width: 2px; border-color: Theme.zinc-700;
                        drop-shadow-blur: 30px; drop-shadow-color: #000000cc;
                        if Detail.game.has-cover: Image { source: Detail.game.cover; width: parent.width; height: parent.height; image-fit: cover; }
                        if !Detail.game.has-cover: Rectangle { background: @linear-gradient(160deg, Detail.game.hue, Theme.zinc-950); }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1; alignment: end; spacing: 6px;
                        HorizontalLayout {
                            spacing: 8px; alignment: start;
                            Text { text: Detail.developer; font-family: Theme.font-mono; font-size: 11px; color: Theme.zinc-400; vertical-alignment: center; }
                            Text { text: "•"; font-size: 11px; color: Theme.zinc-600; vertical-alignment: center; }
                            Text { text: Detail.runner; font-family: Theme.font-mono; font-size: 11px; color: Theme.amber-400; vertical-alignment: center; }
                        }
                        Text { text: Detail.game.title; font-family: Theme.font-display; font-size: 44px; font-weight: 900; color: #ffffff; overflow: elide; }
                        if Detail.game.subtitle != "": Text { text: Detail.game.subtitle; font-family: Theme.font-display; font-size: 16px; font-weight: 700; color: Theme.amber-200; }
                        Text { text: Detail.genres; font-size: 12px; color: Theme.zinc-300; overflow: elide; }
                    }
                }
            }

            // ============ ACTIONS + MÉTRIQUES ============
            VerticalLayout {
                padding-left: root.pad; padding-right: root.pad; padding-top: 4px; spacing: 20px;
                HorizontalLayout {
                    spacing: 12px;
                    Rectangle {
                        width: 200px; height: 48px; border-radius: 12px;
                        background: Detail.game.running ? Theme.rose-600 : Detail.game.starting ? Theme.amber-500 : Detail.game.installed ? (play.has-hover ? Theme.amber-400 : Theme.amber-500) : (play.has-hover ? #158ce0 : Theme.steam-blue);
                        drop-shadow-blur: 24px; drop-shadow-color: Detail.game.running ? #e11d4859 : Detail.game.installed ? Theme.amber-glow : #1a9fff59;
                        HorizontalLayout {
                            alignment: center; spacing: 10px;
                            Ph { weight: 1; text: Detail.game.running ? Icons.stop : Detail.game.installed ? Icons.play : Icons.download; font-size: 18px; color: Detail.game.installed && !Detail.game.running ? Theme.zinc-950 : #ffffff; }
                            Text {
                                text: Detail.game.running ? "Arrêter" : Detail.game.starting ? "Démarrage..." : Detail.game.installed ? (Detail.game.platform-variant == 1 ? "Lancer (Battle.net)" : "Lancer") : (Detail.game.platform-variant == 1 ? "Installer via Battle.net" : "Installer via Steam");
                                font-size: 14px; font-weight: 700; vertical-alignment: center;
                                color: Detail.game.installed && !Detail.game.running ? Theme.zinc-950 : #ffffff;
                            }
                        }
                        play := TouchArea { mouse-cursor: pointer; clicked => { if (Detail.game.running) { Detail.stop(); } else if (Detail.game.installed) { Detail.play(); } else { Detail.install(); } } }
                    }
                    UiButton { y: 0px; variant: 1; size: 1; icon: Detail.game.favorite ? Icons.star : Icons.star; text: Detail.game.favorite ? "Favori" : "Ajouter aux favoris"; clicked => { Detail.toggle-favorite(); } }
                    UiButton { variant: 1; size: 1; icon: Icons.gear; text: "Runner"; clicked => { Detail.cfg-refresh(); Detail.cfg-open = true; } }
                    if Detail.game.installed: UiButton { variant: 1; size: 1; icon: Icons.folder-open; text: "Dossier"; clicked => { Detail.open-folder(); } }
                    if Detail.game.installed && !Detail.game.running: UiButton { variant: 2; size: 1; icon: Icons.x; text: "Désinstaller"; clicked => { Detail.uninstall-open = true; } }
                    Rectangle { horizontal-stretch: 1; }
                    Rectangle {
                        height: 48px; background: #18181be6; border-radius: 14px; border-width: 1px; border-color: Theme.border-subtle;
                        min-width: ml.min-width + 40px; preferred-width: ml.preferred-width + 40px;
                        ml := HorizontalLayout {
                            padding-left: 20px; padding-right: 20px; spacing: 28px;
                            if Detail.rating != "": Metric { label: "NOTE IGDB"; value: Detail.rating; tint: Theme.amber-400; }
                            Metric { label: "DERNIÈRE PARTIE"; value: Detail.last-played; }
                            Metric { label: "TEMPS DE JEU"; value: Detail.game.playtime; }
                            Metric { label: "SUCCÈS"; value: Detail.ach-total > 0 ? Detail.ach-unlocked + "/" + Detail.ach-total : "Non répertoriés"; tint: Theme.amber-300; }
                        }
                    }
                }
                // Liens contextuels
                Rectangle {
                    height: 40px;
                    Rectangle { y: 0px; height: 1px; background: Theme.border-subtle; }
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
                    HorizontalLayout {
                        spacing: 14px; alignment: start;
                        for l in Detail.links: LinkItem { text: l[0]; clicked => { Detail.open-url(l[1]); } }
                    }
                }
            }

            // ============ CONTENU ============
            HorizontalLayout {
                padding-left: root.pad; padding-right: root.pad; padding-top: 28px; padding-bottom: 64px; spacing: 32px;

                // ---- colonne principale ----
                VerticalLayout {
                    horizontal-stretch: 2; spacing: 32px; alignment: start;
                    if Detail.description != "": VerticalLayout {
                        spacing: 12px;
                        SectionHeading { glyph: Icons.info; text: "À propos de " + Detail.game.title; }
                        Text { text: Detail.description; font-size: 13px; color: Theme.zinc-300; wrap: word-wrap; }
                    }
                    if Detail.shots.length > 0: VerticalLayout {
                        spacing: 12px;
                        SectionHeading { glyph: Icons.gamepad; text: "Captures d'écran officielles"; right: Detail.shots.length + " images HD"; }
                        shots := Rectangle {
                            private property <length> tw: (self.width - 12px) / 2;
                            height: ceil(Detail.shots.length / 2) * (tw * 9 / 16 + 12px);
                            for s[i] in Detail.shots: Rectangle {
                                x: mod(i, 2) * (shots.tw + 12px); y: floor(i / 2) * (shots.tw * 9 / 16 + 12px);
                                width: shots.tw; height: shots.tw * 9 / 16; border-radius: 12px; clip: true; background: Theme.zinc-900;
                                border-width: 1px; border-color: st.has-hover ? Theme.amber-border-hover : Theme.border-subtle;
                                if s.has: Image { source: s.img; width: parent.width; height: parent.height; image-fit: cover; transform-scale: st.has-hover ? 1.05 : 1.0; animate transform-scale { duration: 260ms; easing: ease-out; } }
                                st := TouchArea { mouse-cursor: pointer; clicked => { Detail.open-shot(i); } }
                            }
                        }
                    }
                    VerticalLayout {
                        spacing: 14px;
                        HorizontalLayout {
                            spacing: 12px;
                            SectionHeading { horizontal-stretch: 1; glyph: Icons.bell; text: "Actualités & Patch notes"; }
                            Rectangle {
                                height: 32px; background: #18181bcc; border-radius: 16px; border-width: 1px; border-color: Theme.border-subtle;
                                min-width: fl.min-width + 8px; preferred-width: fl.preferred-width + 8px;
                                fl := HorizontalLayout {
                                    padding: 4px; spacing: 2px;
                                    for t[i] in ["Tout", "News", "Updates & patches"]: Rectangle {
                                        min-width: tt.preferred-width + 24px; border-radius: 12px; background: Detail.news-filter == i ? #ffffff : transparent;
                                        tt := Text { text: t; font-size: 11px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; color: Detail.news-filter == i ? Theme.zinc-950 : Theme.zinc-400; }
                                        TouchArea { mouse-cursor: pointer; clicked => { Detail.news-filter = i; } }
                                    }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 14px;
                            for n[i] in Detail.news: VerticalLayout { if Detail.news-filter == 0 || (Detail.news-filter == 1 && !n.patch) || (Detail.news-filter == 2 && n.patch): Rectangle {
                                background: #18181b80; border-radius: 16px; border-width: 1px; border-color: Theme.border-subtle;
                                preferred-height: nl.preferred-height;
                                nl := VerticalLayout {
                                    padding: 20px; spacing: 8px;
                                    HorizontalLayout {
                                        spacing: 8px; alignment: start;
                                        if n.tag != "": Rectangle {
                                            height: 22px; border-radius: 11px; border-width: 1px; min-width: tg.preferred-width + 20px;
                                            background: n.patch ? Theme.amber-bg-faint : Theme.zinc-800; border-color: n.patch ? Theme.amber-border-soft : Theme.zinc-700;
                                            tg := Text { text: n.tag; font-size: 11px; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; color: n.patch ? Theme.amber-300 : Theme.zinc-300; }
                                        }
                                        Text { text: n.author; font-size: 11px; color: Theme.zinc-500; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: n.date; font-family: Theme.font-mono; font-size: 11px; color: Theme.zinc-500; vertical-alignment: center; }
                                    }
                                    Text { text: n.title; font-size: 15px; font-weight: 700; color: Theme.zinc-100; wrap: word-wrap; }
                                    Text { text: n.summary; font-size: 12px; color: Theme.zinc-400; wrap: word-wrap; }
                                    HorizontalLayout {
                                        alignment: start;
                                        Rectangle {
                                            min-width: rl.preferred-width; height: 24px;
                                            rl := Text { text: "Lire l'annonce ↗"; font-size: 12px; font-weight: 600; vertical-alignment: center; color: ra.has-hover ? Theme.amber-300 : Theme.amber-400; }
                                            ra := TouchArea { mouse-cursor: pointer; clicked => { Detail.news-click(i); } }
                                        }
                                    }
                                }
                            } }
                            if Detail.news.length == 0: Rectangle {
                                height: 120px; background: #18181b4d; border-radius: 16px; border-width: 1px; border-color: #27272a99;
                                VerticalLayout {
                                    alignment: center; spacing: 4px;
                                    Text { text: Detail.loading ? "Chargement des actualités..." : "Aucune actualité officielle répertoriée"; font-size: 13px; font-weight: 600; color: Theme.zinc-300; horizontal-alignment: center; }
                                    Text { text: "Les annonces et patch notes synchronisés apparaîtront ici."; font-size: 11px; color: Theme.zinc-500; horizontal-alignment: center; }
                                }
                            }
                        }
                    }
                }

                // ---- colonne latérale ----
                VerticalLayout {
                    horizontal-stretch: 1; min-width: 320px; spacing: 20px; alignment: start;
                    Panel {
                        HorizontalLayout {
                            SectionHeading { horizontal-stretch: 1; glyph: Icons.trophy; text: "Succès"; right: Detail.ach-total > 0 ? Detail.ach-unlocked + "/" + Detail.ach-total : ""; }
                        }
                        if Detail.ach-total > 0: VerticalLayout {
                            spacing: 14px;
                            HorizontalLayout {
                                spacing: 16px;
                                Rectangle {
                                    width: 72px; height: 72px;
                                    Path { width: parent.width; height: parent.height; viewbox-width: 36; viewbox-height: 36; commands: "M18 2 a16 16 0 1 1 0 32 a16 16 0 1 1 0 -32"; stroke: Theme.zinc-800; stroke-width: 3.5px; fill: transparent; }
                                    Path {
                                        width: parent.width; height: parent.height; viewbox-width: 36; viewbox-height: 36;
                                        commands: "M18 2 A16 16 0 " + (Detail.ach-pct > 0.5 ? "1" : "0") + " 1 " + (18 + 16 * sin(Detail.ach-pct * 359.9deg)) + " " + (18 - 16 * cos(Detail.ach-pct * 359.9deg));
                                        stroke: Theme.amber-500; stroke-width: 3.5px; stroke-line-cap: round; fill: transparent;
                                    }
                                    Text { text: round(Detail.ach-pct * 100) + "%"; font-family: Theme.font-mono; font-size: 14px; font-weight: 800; color: Theme.amber-400; horizontal-alignment: center; vertical-alignment: center; }
                                }
                                VerticalLayout {
                                    alignment: center; spacing: 2px;
                                    Text { text: Detail.ach-unlocked + " sur " + Detail.ach-total + " débloqués"; font-size: 13px; font-weight: 600; color: Theme.zinc-100; }
                                    Text { text: (Detail.ach-total - Detail.ach-unlocked) + " succès restants"; font-size: 11px; color: Theme.zinc-500; }
                                }
                            }
                            if Detail.ach-preview.length > 0: VerticalLayout {
                                spacing: 10px;
                                Text { text: "APERÇU DES SUCCÈS"; font-family: Theme.font-mono; font-size: 10px; font-weight: 600; color: Theme.zinc-500; }
                                for a in Detail.ach-preview: AchItem { a: a; }
                            }
                            UiButton { variant: 1; size: 0; block: true; icon: Icons.trophy; text: "Voir tous les succès (" + Detail.ach-total + ")"; clicked => { Detail.ach-open = true; } }
                        }
                        if Detail.ach-total == 0: VerticalLayout {
                            padding-top: 8px; padding-bottom: 8px; spacing: 4px;
                            Text { text: "Aucun succès répertorié"; font-size: 13px; font-weight: 600; color: Theme.zinc-300; horizontal-alignment: center; }
                            Text { text: "Ce titre ne comporte aucun succès officiel sur cette plateforme."; font-size: 11px; color: Theme.zinc-500; horizontal-alignment: center; wrap: word-wrap; }
                        }
                    }
                    Panel {
                        HorizontalLayout { Text { horizontal-stretch: 1; text: Detail.game.platform-variant == 1 ? "PRÉFIXE WINE & ENVIRONNEMENT" : "RUNNER CONFIGURATION"; font-family: Theme.font-mono; font-size: 11px; font-weight: 700; color: Theme.zinc-300; } UiBadge { text: Detail.game.platform-variant == 1 ? "LOOM WINE 64" : "LOOM CORE"; variant: 1; } }
                        VerticalLayout {
                            spacing: 10px;
                            for r in Detail.cfg-rows: HorizontalLayout {
                                spacing: 12px;
                                Text { text: r[0]; font-size: 12px; color: Theme.zinc-500; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: r[1]; font-family: Theme.font-mono; font-size: 11px; color: Theme.zinc-200; horizontal-alignment: right; overflow: elide; vertical-alignment: center; }
                            }
                        }
                    }
                    if Detail.stores.length > 0: Panel {
                        Text { text: "BOUTIQUES OFFICIELLES"; font-family: Theme.font-mono; font-size: 11px; font-weight: 700; color: Theme.zinc-300; }
                        for s in Detail.stores: Rectangle {
                            height: 40px; border-radius: 10px; border-width: 1px; background: sa.has-hover ? Theme.zinc-800 : #09090b99; border-color: sa.has-hover ? Theme.amber-border-soft : Theme.zinc-800;
                            HorizontalLayout { padding-left: 12px; padding-right: 12px; Text { horizontal-stretch: 1; text: s[0]; font-size: 12px; font-weight: 600; color: Theme.zinc-200; vertical-alignment: center; } Ph { text: Icons.external; font-size: 12px; color: Theme.zinc-500; width: 14px; } }
                            sa := TouchArea { mouse-cursor: pointer; clicked => { Detail.open-url(s[1]); } }
                        }
                    }
                }
            }
            Rectangle { vertical-stretch: 1; }
        }
    }

    // ---- modale : tous les succès ----
    UiModal {
        open: Detail.ach-open; title: "Succès — " + Detail.game.title; subtitle: Detail.ach-unlocked + " sur " + Detail.ach-total + " débloqués";
        dialog-width: 640px;
        close => { Detail.ach-open = false; }
        ScrollView {
            height: 420px;
            VerticalLayout { spacing: 8px; for a in Detail.ach-all: AchItem { a: a; } }
        }
    }
    // ---- modale : capture HD ----
    UiModal {
        open: Detail.shot-open; title: "Aperçu HD"; dialog-width: 900px;
        close => { Detail.shot-open = false; }
        Rectangle {
            height: 440px; border-radius: 12px; clip: true; background: Theme.zinc-950;
            if Detail.shot-ready: Image { source: Detail.shot-big; width: parent.width; height: parent.height; image-fit: contain; }
            if !Detail.shot-ready: Text { text: "Chargement..."; font-size: 12px; color: Theme.zinc-500; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    // ---- modale : désinstallation ----
    UiModal {
        open: Detail.uninstall-open; title: "Désinstaller " + Detail.game.title; subtitle: "Confirmation de désinstallation"; dialog-width: 448px;
        close => { Detail.uninstall-open = false; }
        VerticalLayout {
            spacing: 14px;
            Text { text: "Le jeu sera désinstallé via " + (Detail.game.platform-variant == 1 ? "Battle.net" : "Steam") + ". Vos sauvegardes cloud ne sont pas supprimées."; font-size: 13px; color: Theme.zinc-300; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 8px; alignment: end;
                UiButton { variant: 3; size: 0; text: "Annuler"; clicked => { Detail.uninstall-open = false; } }
                UiButton { variant: 4; size: 0; text: "Désinstaller"; clicked => { Detail.uninstall-confirm(); } }
            }
        }
    }

    // ---- modale : configuration du runner ----
    UiModal {
        open: Detail.cfg-open; title: "Configuration du Runner"; subtitle: Detail.game.title; dialog-width: 512px;
        close => { Detail.cfg-open = false; }
        VerticalLayout {
            spacing: 14px;
            VerticalLayout { spacing: 6px; FieldLabel { text: "VERSION PROTON / WINE"; } UiSelect { options: ["GE-Proton 9-20 (Recommandé)", "Proton Experimental", "Wine Staging (Système)", "Linux Natif"]; current <=> Detail.cfg-runner; } }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout { horizontal-stretch: 1; spacing: 2px; Text { text: "Activer Feral GameMode"; font-size: 14px; font-weight: 500; color: Theme.zinc-200; } Text { text: "Optimise les fréquences CPU & I/O scheduler"; font-size: 12px; color: Theme.zinc-400; } }
                UiSwitch { checked <=> Detail.cfg-gamemode; }
            }
            HorizontalLayout {
                spacing: 12px;
                VerticalLayout { horizontal-stretch: 1; spacing: 2px; Text { text: "Affichage MangoHud (FPS / Temp)"; font-size: 14px; font-weight: 500; color: Theme.zinc-200; } Text { text: "Overlay Vulkan en jeu"; font-size: 12px; color: Theme.zinc-400; } }
                UiSwitch { checked <=> Detail.cfg-mangohud; }
            }
            VerticalLayout { spacing: 6px; FieldLabel { text: "VARIABLES D'ENVIRONNEMENT PERSONNALISÉES"; } SecretInput { text <=> Detail.cfg-env; placeholder: "VKD3D_CONFIG=dxr DXVK_ASYNC=1"; } }
            VerticalLayout {
                spacing: 6px;
                FieldLabel { text: Detail.game.platform-variant == 1 ? "APPLIQUÉ AU PRÉFIXE BATTLE.NET (GameMode, MangoHud, variables)" : "OPTIONS DE LANCEMENT STEAM"; }
                Rectangle {
                    background: #09090b; border-radius: 12px; border-width: 1px; border-color: Theme.zinc-800; preferred-height: lo.preferred-height;
                    lo := HorizontalLayout { padding: 12px; spacing: 10px; Text { horizontal-stretch: 1; text: Detail.launch-opts; font-family: Theme.font-mono; font-size: 11px; color: Theme.zinc-300; wrap: word-wrap; vertical-alignment: center; } UiButton { variant: 1; size: 0; icon: Icons.copy; text: "Copier"; clicked => { Detail.cfg-copy(); } } }
                }
                if Detail.game.platform-variant != 1: Text { text: "Steam ne permet pas de les imposer de l'extérieur : collez cette ligne dans Propriétés → Options de lancement."; font-size: 11px; color: Theme.zinc-500; wrap: word-wrap; }
            }
            HorizontalLayout {
                spacing: 8px; alignment: end;
                UiButton { variant: 3; size: 0; text: "Annuler"; clicked => { Detail.cfg-open = false; } }
                UiButton { variant: 0; size: 0; text: "Enregistrer"; clicked => { Detail.cfg-save(); } }
            }
        }
    }
}
