// Tokens extraits de tailwind.config.js + main.css (thème "amber" par défaut).
import "fonts/Phosphor.ttf";
import "fonts/Phosphor-Fill.ttf";
import "fonts/Phosphor-Bold.ttf";

export global Theme {
    // Zinc
    out property <color> zinc-950: #09090b;
    out property <color> zinc-900: #18181b;
    out property <color> zinc-800: #27272a;
    out property <color> zinc-700: #3f3f46;
    out property <color> zinc-600: #52525b;
    out property <color> zinc-500: #71717a;
    out property <color> zinc-400: #a1a1aa;
    out property <color> zinc-300: #d4d4d8;
    out property <color> zinc-200: #e4e4e7;
    out property <color> zinc-100: #f4f4f5;

    // Alias sémantiques
    out property <color> bg-root: #09090b;
    out property <color> bg-header: #09090be6;        // zinc-950/90
    out property <color> bg-surface: #18181b;
    out property <color> bg-card: #18181bcc;          // zinc-900/80
    out property <color> bg-elevated: #27272a;
    out property <color> border-subtle: #27272acc;    // zinc-800/80
    out property <color> border-strong: #3f3f46cc;    // zinc-700/80

    // Accent (thème « amber » par défaut ; modifiable depuis Paramètres → Apparence)
    in-out property <color> amber-500: #f59e0b;
    in-out property <color> amber-400: #fbbf24;
    in-out property <color> amber-300: #fcd34d;
    in-out property <color> amber-200: #fde68a;
    in-out property <color> amber-600: #d97706;
    out property <color> amber-bg: amber-500.with-alpha(0.15);
    out property <color> amber-bg-faint: amber-500.with-alpha(0.10);
    out property <color> amber-border: amber-500.with-alpha(0.35);
    out property <color> amber-border-soft: amber-500.with-alpha(0.30);
    out property <color> amber-border-hover: amber-500.with-alpha(0.50);
    out property <color> amber-glow: amber-500.with-alpha(0.40);

    // Statuts
    out property <color> emerald-400: #34d399;
    out property <color> emerald-300: #6ee7b7;
    out property <color> emerald-500: #10b981;
    out property <color> sky-400: #38bdf8;
    out property <color> sky-300: #7dd3fc;
    out property <color> rose-600: #e11d48;
    out property <color> rose-500: #f43f5e;
    out property <color> rose-400: #fb7185;
    out property <color> rose-300: #fda4af;
    out property <color> purple-400: #c084fc;
    out property <color> purple-300: #d8b4fe;
    out property <color> steam-blue: #1a9fff;

    // Typographie
    out property <string> font-sans: "Inter";
    out property <string> font-mono: "JetBrains Mono";
    out property <string> font-display: "Cinzel";
}

// Codepoints Phosphor (régulier / fill / bold partagent les mêmes).
export global Icons {
    out property <string> arrow-left: "\u{e058}";
    out property <string> arrow-right: "\u{e06c}";
    out property <string> arrow-up: "\u{e08e}";
    out property <string> search: "\u{e30c}";
    out property <string> download: "\u{e20c}";
    out property <string> bell: "\u{e0ce}";
