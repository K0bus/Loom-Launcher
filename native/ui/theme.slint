    out property <string> palette: "\u{e6c8}";
    out property <string> terminal: "\u{e47e}";
    out property <string> check: "\u{e182}";
    out property <string> reset: "\u{e038}";
    out property <string> user-check: "\u{eafa}";
    out property <string> link: "\u{e2e2}";
    out property <string> unlink: "\u{e2e4}";
    out property <string> folder-plus: "\u{e258}";
    out property <string> external: "\u{e5de}";
    out property <string> caret-up: "\u{e13c}";
    out property <string> cpu: "\u{e610}";
    out property <string> bell-ring: "\u{e5e8}";
    out property <string> users: "\u{e4d6}";
}
