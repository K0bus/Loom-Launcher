    out property <string> caret-down: "\u{e136}";
    out property <string> check-circle: "\u{e184}";
    out property <string> squares: "\u{e464}";
    out property <string> cloud-down: "\u{e1ac}";
    out property <string> shield-check: "\u{e40c}";
    out property <string> warning: "\u{e4e2}";
    out property <string> info: "\u{e2ce}";
    out property <string> eye: "\u{e220}";
    out property <string> database: "\u{e1de}";
    out property <string> key: "\u{e2d6}";
