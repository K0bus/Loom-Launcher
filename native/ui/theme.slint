    out property <string> gamepad: "\u{e26e}";
    out property <string> sliders: "\u{e434}";
    out property <string> refresh: "\u{e094}";
    out property <string> globe: "\u{e28c}";
    out property <string> stack: "\u{e466}";
    out property <string> hard-drive: "\u{e29e}";
